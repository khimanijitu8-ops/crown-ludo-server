# ==============================================================================
# 👑 ROYAL LUDO 3D — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. Never commit real secrets to source control!
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=8080
LOG_ENABLED=true

# Authentication & JWT Secrets (In production, generate with: openssl rand -hex 32)
JWT_SECRET=dev_jwt_secret_royal_ludo_3d_insecure_only_for_local_testing_12345
JWT_REFRESH_SECRET=dev_refresh_secret_royal_ludo_3d_insecure_local_testing_67890
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d
AUTH_REQUIRED=false

# PostgreSQL Database (Optional for dev/test: falls back to in-memory store)
DATABASE_URL=postgres://royal_user:royal_password@localhost:5432/royal_ludo_db

# Redis Coordination (Optional for dev/test: falls back to in-memory store)
REDIS_URL=redis://localhost:6379

# Network & Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,https://royal-ludo-server.onrender.com
MAX_ROOMS=200
MAX_CONNECTIONS_PER_IP=30
HEARTBEAT_INTERVAL_MS=15000
TURN_TIMEOUT_MS=15000
GRACE_PERIOD_MS=30000
CLEANUP_SWEEP_MS=300000
IDLE_AUTH_TIMEOUT_MS=10000

# Administration
ADMIN_API_KEY=rl_admin_default_sec_token_987654
